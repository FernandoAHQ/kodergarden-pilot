{
  "name": "@kodergarden/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node dist/live-session.service.test.js && node dist/live.gateway.test.js",
    "test:live-load": "pnpm build && node dist/live-load.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kodergarden/engine": "workspace:*",
    "@kodergarden/language": "workspace:*",
    "@kodergarden/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.6"
  }
}
