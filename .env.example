# The hosting platform normally supplies PORT. Kodergarden defaults to 3001.
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
DATABASE_URL=postgresql://kodergarden:kodergarden@localhost:55432/kodergarden
DATABASE_SSL=false

# Leave empty when the web app and Socket.IO share one origin (recommended).
# For a separately hosted web app, provide exact comma-separated HTTPS origins.
# CORS_ORIGINS=https://kodergarden.example.com,https://school.example.org
CORS_ORIGINS=
